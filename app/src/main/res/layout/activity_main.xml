<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xcam_bg">

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/cd_flash"
        android:src="@drawable/ic_flash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/xcam_text" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.3"
        android:text="XCAM"
        android:textColor="@color/xcam_cyan"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnFlash"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintStart_toEndOf="@id/btnFlash"
        app:layout_constraintTop_toTopOf="@id/btnFlash" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnFlash"
        app:tint="@color/xcam_text" />

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_preview"
        app:layout_constraintBottom_toTopOf="@id/modeBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFlash">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.xcam.camera.camera.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/previewFreeze"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="invisible" />

        <View
            android:id="@+id/focusRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="top|start"
            android:alpha="0"
            android:background="@drawable/bg_focus_ring"
            android:visibility="invisible" />

        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@android:color/white" />

        <FrameLayout
            android:id="@+id/zoomSliderPanel"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="76dp"
            android:alpha="0"
            android:background="@drawable/bg_zoom_bar"
            android:visibility="invisible">

            <SeekBar
                android:id="@+id/zoomSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:max="10000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/xcam_cyan"
                android:splitTrack="false"
                android:thumbTint="@color/xcam_cyan" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_zoom_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rec_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <View
                android:id="@+id/recDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_shutter_video" />

            <TextView
                android:id="@+id/recTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:00"
                android:textColor="@color/xcam_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnStab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_rec_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="EIS"
            android:textColor="@color/xcam_text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_rec_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/xcam_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rec_pill"
                android:contentDescription="@string/cd_fps"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/xcam_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rec_pill"
                android:contentDescription="@string/cd_quality"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="@color/xcam_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/permission_hint"
            android:textColor="@color/xcam_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/modeBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_mode_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/shutterContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/mode_photo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeVideo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/mode_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeLive"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/mode_live"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/shutterContainer"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shutter_ring" />

        <View
            android:id="@+id/shutterInner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shutter_photo" />

        <View
            android:id="@+id/shutterTouch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/cd_shutter"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_thumb"
        android:contentDescription="@string/gallery"
        android:scaleType="center"
        android:src="@drawable/ic_gallery"
        app:layout_constraintBottom_toBottomOf="@id/shutterContainer"
        app:layout_constraintEnd_toStartOf="@id/shutterContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/shutterContainer"
        app:tint="@color/xcam_text" />

    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/cd_switch_camera"
        android:src="@drawable/ic_flip_camera"
        app:layout_constraintBottom_toBottomOf="@id/shutterContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shutterContainer"
        app:layout_constraintTop_toTopOf="@id/shutterContainer"
        app:tint="@color/xcam_text" />

</androidx.constraintlayout.widget.ConstraintLayout>
